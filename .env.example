# ==========================================
# Configurações de Credenciais e Segurança - Versão Híbrida
# ==========================================

# Opção 1: API Key do Google Gemini (Recomendado - mais simples)
GEMINI_API_KEY_1=your_first_api_key_here
GEMINI_API_KEY_2=your_second_api_key_here

# Opção 2: Service Account (Fallback automático)
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# Google Drive (OAuth2 - para correção em lote)
DRIVE_CREDENTIALS_FILE=credentials.json
DRIVE_TOKEN_FILE=token.json

# ==========================================
# Configurações da Inteligência Artificial
# ==========================================
GEMINI_MODEL_NAME=gemini-2.5-flash

# ==========================================
# Configurações do Google Drive (Correção em Lote)
# ==========================================
DRIVE_FOLDER_INPUT_ID=1c_8ybbo6HAhMxlOeNKX71PPF8TfySKx-
DRIVE_FOLDER_OUTPUT_ID=16xRIPkBY8gRp9vNzxgH1Ex4GhTnkzbed

# ==========================================
# Configurações da Aplicação
# ==========================================
DEBUG=false
HOST=0.0.0.0
PORT=8501

# ==========================================
# Configurações de Performance
# ==========================================
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=8000
MAX_CONCURRENT_ANALYSES=5
ANALYSIS_TIMEOUT_SECONDS=300

# ==========================================
# Configurações de Arquivos
# ==========================================
MAX_FILE_SIZE_MB=10
TEMPLATE_DOCX_FILE=template.docx
PROMPT_FILE=prompt.txt
TMP_DIR=tmp
TEMP_UPLOADS_DIR=temp_uploads
TEMP_LOTE_DIR=temp_lote

# ==========================================
# Configurações de Cache
# ==========================================
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ==========================================
# Configurações de Segurança
# ==========================================
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Configurações de Logging
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# Configurações de Rotação de API Keys
# ==========================================
# Número máximo de requisições por chave antes de rotacionar
MAX_REQUESTS_PER_KEY=100

# Ativar rotação automática quando quota for excedida
ROTATION_ON_QUOTA_EXCEEDED=true

# ==========================================
# Configurações Adicionais
# ==========================================
# Configurações de Cache
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Configurações de Segurança
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Configurações de Logging
LOG_LEVEL=INFO
